# ──────────────────────────────────────────
# AI Recruiter — Environment Configuration
# ──────────────────────────────────────────

# App
APP_NAME=AI Recruiter
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (MySQL)
DATABASE_URL=mysql+pymysql://recruiter:recruiter123@localhost:3306/ai_recruiter

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Email — Microsoft Graph API (Outlook / cloudmetica.com)
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=your-azure-tenant-id
OUTLOOK_SENDER_EMAIL=reply@cloudmetica.com

# datagenius Integration
DATAGENIUS_API_URL=http://localhost:8000
DATAGENIUS_API_KEY=

# Frontend URL (for shareable links in emails)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
